# Copy this file to .env and fill in your own Razorpay keys.
# Get test keys from: Razorpay Dashboard > Settings > API Keys > Generate Test Key
# https://dashboard.razorpay.com/app/keys

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Postgres connection string for the product catalog / contacts / orders
# database — a free Neon (neon.tech) project works well. Required for the
# site to serve its catalog at all (see server/db/); everything else in this
# file is optional in comparison.
DATABASE_URL=

# Optional — only needed once you configure a webhook in the Razorpay Dashboard
# (requires a public HTTPS URL, so this stays blank for local dev).
RAZORPAY_WEBHOOK_SECRET=

# Optional — a long random string. Two jobs: (1) the one-time "admin setup
# key" someone enters, alongside a new password, to claim one of the admin
# emails listed in server/db/schema.sql at /admin — everyday login after that
# is just their email + password, this key is never needed again for them;
# (2) unlocks the discount usage report at GET /api/admin/discounts (send it
# as `Authorization: Bearer <token>`). Leave blank and /admin refuses every
# login and that report endpoint doesn't exist at all.
ADMIN_TOKEN=

# Backend port (the Vite dev server proxies /api requests here). Named
# SERVER_PORT, not PORT, so it can't collide with a PORT env var your host
# or dev launcher may already set for the frontend.
SERVER_PORT=8787

# Email — the contact form, waitlist, and order confirmations all send
# through the Gmail API (not SMTP; see server/gmailApi.js for why) as
# CONTACT_EMAIL_USER. CONTACT_TO_EMAIL is optional and defaults to that same
# address, so a single Gmail account both sends and receives the shop's own
# copies (new orders, contact enquiries, waitlist signups).
#
# The three GMAIL_OAUTH_* values come from a one-time setup — see the
# README's "Email sending" section, then run:
#   node scripts/gmailOAuthSetup.mjs
# All four are required together; leave any blank and no email sends at all
# (the site still works — the contact form and waitlist save to the database
# regardless, see server/index.js's DB-first comments — nothing just gets
# emailed anywhere).
CONTACT_EMAIL_USER=
CONTACT_TO_EMAIL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Optional — pushes every paid order into the Shiprocket panel (see
# server/shiprocket.js) so it's ready to ship; "push to panel only", it
# never picks a courier or schedules a pickup itself. SHIPROCKET_EMAIL/
# PASSWORD are a DEDICATED API user (Shiprocket dashboard: Settings > API >
# Add New API User — must be a different email than your main login).
# SHIPROCKET_PICKUP_LOCATION must match, character-for-character, a pickup
# address nickname already saved in your Shiprocket panel (Settings > Pickup
# Addresses). Leave any of the three blank and this step is skipped
# entirely — paid orders still work fully otherwise, see /admin → Orders.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
