# Copy this file to .env and fill in your own Razorpay keys.
# Get test keys from: Razorpay Dashboard > Settings > API Keys > Generate Test Key
# https://dashboard.razorpay.com/app/keys

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Postgres connection string for the product catalog / contacts / orders
# database — a free Neon (neon.tech) project works well. Required for the
# site to serve its catalog at all (see server/db/); everything else in this
# file is optional in comparison.
DATABASE_URL=

# Optional — only needed once you configure a webhook in the Razorpay Dashboard
# (requires a public HTTPS URL, so this stays blank for local dev).
RAZORPAY_WEBHOOK_SECRET=

# Optional — a long random string. Two jobs: (1) the one-time "admin setup
# key" someone enters, alongside a new password, to claim one of the admin
# emails listed in server/db/schema.sql at /admin — everyday login after that
# is just their email + password, this key is never needed again for them;
# (2) unlocks the discount usage report at GET /api/admin/discounts (send it
# as `Authorization: Bearer <token>`). Leave blank and /admin refuses every
# login and that report endpoint doesn't exist at all.
ADMIN_TOKEN=

# Backend port (the Vite dev server proxies /api requests here). Named
# SERVER_PORT, not PORT, so it can't collide with a PORT env var your host
# or dev launcher may already set for the frontend.
SERVER_PORT=8787

# Contact form (the popup opened from the email icon in the footer).
# CONTACT_EMAIL_USER sends the mail; CONTACT_EMAIL_PASS is a Gmail App
# Password, not your normal Gmail password (Google Account > Security >
# 2-Step Verification > App passwords; requires 2FA to be on).
# CONTACT_TO_EMAIL is optional and defaults to CONTACT_EMAIL_USER, so a
# single Gmail account can both send and receive the messages.
# The same inbox also receives one "New order" email per paid order, with the
# customer's details, items and delivery address.
CONTACT_EMAIL_USER=
CONTACT_EMAIL_PASS=
CONTACT_TO_EMAIL=
